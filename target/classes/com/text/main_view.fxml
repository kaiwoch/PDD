<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1000.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.text.MainController">
   <children>
      <Label text="Правила дорожного движения">
         <font>
            <Font size="18.0" />
         </font></Label>
      <Button fx:id="startButton" mnemonicParsing="false" onAction="#startTest" text="Начать тестирование" />
      <Label fx:id="statusLabel" text="Ожидание начала тестирования" />
      <ImageView fx:id="questionImageView" fitHeight="1000.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="questionLabel">
         <font>
            <Font size="14.0" />
         </font></Label>
      <VBox fx:id="answersContainer" prefHeight="200.0" prefWidth="100.0" />
      <Button fx:id="checkAnswerButon" mnemonicParsing="false" onAction="#checkAnswer" text="Проверить ответ" />
      <Label fx:id="correctLabel" />
      <Label fx:id="descriptionLabel" underline="true">
         <font>
            <Font size="14.0" />
         </font></Label>
   </children>
</VBox>
